{
  "manifest_version": 3,
  "name": "Site Jumper",
  "version": "0.6.0",
  "description": "Встраивает плееры (список берётся с того же API, что и у зеркала) между обложкой и трейлером на страницах фильмов и сериалов Кинопоиска, с выбором плеера и озвучки.",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["*://*.kinopoisk.ru/*", "*://kinopoisk.ru/*", "https://fbphdplay.top/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "declarative_net_request": {
    "rule_resources": [{ "id": "embed_csp", "enabled": true, "path": "rules.json" }]
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "site-jumper@rmr",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.kinopoisk.ru/*", "*://kinopoisk.ru/*"],
      "js": ["rules.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
